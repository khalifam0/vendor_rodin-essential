# Baseline policy for the Rodin vendor image. Verify the labels against the
# exact vendor build used by the ROM before shipping; OEM ports can rename
# individual types while exposing the same kernel nodes.

# CPU, UFS, GPU, GED, thermal, charging, touch, and ZRAM controls.
allow rodin_daemon sysfs_devices_system_cpu:dir search;
allow rodin_daemon sysfs_devices_system_cpu:file rw_file_perms;
allow rodin_daemon sysfs_devices_block:dir search;
allow rodin_daemon sysfs_devices_block:file rw_file_perms;
allow rodin_daemon sysfs_memory:dir search;
allow rodin_daemon sysfs_memory:file rw_file_perms;
allow rodin_daemon sysfs_ged:dir search;
allow rodin_daemon sysfs_ged:file rw_file_perms;
allow rodin_daemon sysfs_therm:dir r_dir_perms;
allow rodin_daemon sysfs_therm:file rw_file_perms;
# Battery/USB class links resolve through battery-manager/power_supply.
allow rodin_daemon sysfs_batteryinfo:dir search;
allow rodin_daemon sysfs_batteryinfo:file rw_file_perms;
allow rodin_daemon sysfs_battery_supply:dir search;
allow rodin_daemon sysfs_usb_supply:dir search;
allow rodin_daemon sysfs_usb_supply:file rw_file_perms;
allow rodin_daemon sysfs_battery_supply:file rw_file_perms;
allow rodin_daemon sysfs_zram:dir r_dir_perms;
allow rodin_daemon sysfs_zram:file rw_file_perms;
allow rodin_daemon sysfs_fs_f2fs:file rw_file_perms;
allow rodin_daemon sysfs_blockio:file rw_file_perms;
allow rodin_daemon vendor_sysfs_displayfeature:dir r_dir_perms;
allow rodin_daemon vendor_sysfs_displayfeature:file r_file_perms;
allow rodin_daemon sysfs_leds:dir r_dir_perms;
allow rodin_daemon proc_powerhal_cpu_ctrl:file rw_file_perms;
allow rodin_daemon proc_touch_boost:file rw_file_perms;
allow rodin_daemon proc_swappiness:file rw_file_perms;
allow rodin_daemon proc_drop_caches:file w_file_perms;
allow rodin_daemon input_device:chr_file rw_file_perms;
allow rodin_daemon swap_block_device:blk_file rw_file_perms;

# These Rodin nodes are generic sysfs in the stock vendor image. Relabel only
# their exact subtrees so the coredomain never receives generic sysfs access.
type sysfs_rodin_mali_devfreq, fs_type, sysfs_type;
type sysfs_rodin_touch, fs_type, sysfs_type;
type sysfs_rodin_subsystem, fs_type, sysfs_type;
type sysfs_rodin_subsystem_floor, fs_type, sysfs_type;
allow rodin_daemon sysfs_rodin_subsystem:dir r_dir_perms;
allow rodin_daemon sysfs_rodin_subsystem:file r_file_perms;
# Only supported devfreq floor requests are writable, not force/voltage nodes.
allow rodin_daemon sysfs_rodin_subsystem_floor:file rw_file_perms;
# Existing RAM devfreq metadata label must not be replaced or duplicated.
allow rodin_daemon sysfs_dvfsrc_devfreq:dir r_dir_perms;
allow rodin_daemon sysfs_dvfsrc_devfreq:file r_file_perms;
# Preserve OEM PowerHAL access on the newly labeled request files/UFS subtree.
# These grants belong to the existing controller, not to the Rodin app.
allow mtk_hal_power sysfs_rodin_subsystem:dir r_dir_perms;
allow mtk_hal_power sysfs_rodin_subsystem:file rw_file_perms;
allow mtk_hal_power sysfs_rodin_subsystem_floor:file rw_file_perms;

allow rodin_daemon sysfs:dir search;
allow rodin_daemon sysfs_rodin_mali_devfreq:dir r_dir_perms;
allow rodin_daemon sysfs_rodin_mali_devfreq:file rw_file_perms;
allow rodin_daemon sysfs_rodin_touch:dir r_dir_perms;
allow rodin_daemon sysfs_rodin_touch:file rw_file_perms;

# Xiaomi display and touch AIDL services.
binder_call(rodin_daemon, vendor_hal_displayfeature_default)
binder_call(rodin_daemon, hal_touchfeature_xiaomi_default)
allow rodin_daemon vendor_hal_displayfeature_service:service_manager find;
allow rodin_daemon hal_touchfeature_xiaomi_service:service_manager find;

# Device tree specific sysfs and proc nodes for touch and battery/usb.
allow rodin_daemon vendor_proc_tp_file:file r_file_perms;
# Lockdown info identifies the touch panel variant (Goodix / FocalTech).
# Declared separately from vendor_proc_tp_file in the device tree file.te.
allow rodin_daemon vendor_proc_tp_lockdown:file r_file_perms;
allow rodin_daemon vendor_sysfs_touch:dir r_dir_perms;
allow rodin_daemon vendor_sysfs_touch:file rw_file_perms;
# THP timing nodes (touch_thp_*) carry the label sysfs_touch_hostprocess
# because genfs uses the most specific path match: the parent directory
# /devices/virtual/touch/touch_dev gets vendor_sysfs_touch, but every
# touch_thp_* file inside it gets sysfs_touch_hostprocess. Without this
# rule the 240/480 Hz cadence restore is denied on both panel variants.
allow rodin_daemon sysfs_touch_hostprocess:file rw_file_perms;
allow rodin_daemon input_device:dir r_dir_perms;
allow rodin_daemon sysfs_battery_supply:lnk_file r_file_perms;
allow rodin_daemon sysfs_usb_supply:lnk_file r_file_perms;
allow rodin_daemon vendor_sysfs_battery_supply:dir r_dir_perms;
allow rodin_daemon vendor_sysfs_battery_supply:file rw_file_perms;
allow rodin_daemon vendor_sysfs_battery_supply:lnk_file r_file_perms;
allow rodin_daemon vendor_sysfs_usb_supply:dir r_dir_perms;
allow rodin_daemon vendor_sysfs_usb_supply:file rw_file_perms;
allow rodin_daemon vendor_sysfs_usb_supply:lnk_file r_file_perms;

# CPU frequency limits and CPU core online controls from the device tree
allow rodin_daemon vendor_sysfs_cpu_control:file rw_file_perms;

# Rodin's vendor touch service keeps the selected native panel cadence in its
# private THP timing block. Restrict cross-process access to that one HAL so
# 240/480 Hz restoration works for both Goodix and FocalTech panel variants.
allow rodin_daemon hal_touchfeature_xiaomi_default:process ptrace;
allow rodin_daemon hal_touchfeature_xiaomi_default:dir search;
allow rodin_daemon hal_touchfeature_xiaomi_default:file { getattr open read write };

# ROM-native 1000 Hz output opens the SELinux-labelled Rodin input event
# directly. It does not inspect or trace the touch service process.
